:color-mix(in srgb,var(--color-accent) 70%,transparent)}p.panel_toolbar_label{font-size:12px;color:var(--color-subtle_text);font-weight:500}.outliner_object{border-radius:6px;font-size:13px;transition:background-color .1s}.outliner_object:hover{background-color:var(--x)}.outliner_object.selected,.outliner_object:active,.outliner_object.selected:hover{background-color:var(--xx)}.outliner_object .icon{color:var(--color-subtle_text)}.outliner_object.selected .icon{color:var(--color-text)}#cubes_list{padding:0 6px}.collection,.texture,.animation,.texture_layer{border-radius:8px}.collection:hover,.texture:hover,.animation:hover{background-color:var(--x)}.collection.selected,.texture.selected,.animation.selected,.texture_layer.selected,.collection:active{background:var(--xx)}.texture.multi_selected,.texture_layer:hover{background-color:var(--x)}.contextMenu{background-color:var(--p0p);color:var(--color-text);border-radius:12px;padding:5px;box-shadow:var(--sh);min-width:190px;font-size:14px}.contextMenu li{border-radius:8px;height:32px;padding:5px 10px 5px 36px;align-items:center}.contextMenu li.focused,.contextMenu li.parent.opened{background-color:var(--x);color:var(--color-light)}.contextMenu li>.icon,.contextMenu li>i{color:var(--color-subtle_text)}.contextMenu li.focused>.icon,.contextMenu li.focused>i{color:var(--color-light)}.contextMenu .menu_more_button:hover,.hybrid_parent.opened .menu_more_button{background-color:var(--xx);color:var(--color-light)}.contextMenu li.menu_separator{height:1px;min-height:1px;padding:0;margin:5px 4px;background-color:var(--tmp2);border-radius:0}.contextMenu li.menu_separator.has_label{height:auto;background:transparent;margin-top:8px;padding:0 10px}li.menu_separator.has_label>label{background-color:var(--p0p);color:var(--color-subtle_text);font-size:12px}.contextMenu li label.keybinding_label,.contextMenu .keybinding_label{color:var(--color-subtle_text);font-size:12px}.contextMenu .menu_search_bar,.contextMenu input{border-radius:8px}.tooltip{background:var(--p0p);color:var(--color-light);border-radius:8px;box-shadow:var(--sh);font-size:12px;height:auto;min-height:26px;padding:4px 9px;font-weight:500}.tooltip_description{background-color:var(--p0p);color:var(--color-text);border-radius:8px;box-shadow:var(--sh);font-weight:400}#quick_message_box,#cursor_tooltip,.uv_message_box,.annotation{background-color:var(--p0p);color:var(--color-light);border-radius:10px;box-shadow:var(--sh)}.toast_notification{background-color:var(--p0p);color:var(--color-light);border-radius:12px;box-shadow:var(--sh)}.toast_notification>.icon{color:var(--color-accent)}button{border-radius:8px;box-shadow:none;background:var(--btn);color:var(--color-light);font-weight:500;font-size:14px;transition:background-color .12s}button:hover{background:var(--btn2);color:var(--color-light)}button:focus{text-decoration:none}button:focus-visible{box-shadow:0 0 0 1px var(--asdf),0 0 0 2.5px var(--blu)}button.minor{background:transparent}button.minor:hover{background:var(--x)}.dialog_bar>button.confirm_btn,.dialog_bar>button.confirm_btn:not(:hover),button.confirm_btn{background-color:var(--b1);color:var(--b3)}.dialog_bar>button.confirm_btn:hover,button.confirm_btn:hover{background-color:var(--b2);color:var(--b3)}#web_download_button,#web_download_button:hover{background:transparent}.dark_bordered,textarea,.prism-editor-wrapper{background-color:var(--fld);border:1px solid var(--tmp2);border-radius:8px}.dark_bordered:focus,textarea:focus,.dark_bordered:focus-within{border-color:var(--blu);box-shadow:0 0 0 3px color-mix(in srgb,var(--blu) 22%,transparent)}input[type=text],input[type=number],input[type=search]{caret-color:var(--color-accent)}div.nslide{background-color:var(--fld);box-shadow:inset 0 0 0 1px var(--tmp2);border-radius:6px}div.nslide:hover{background-color:var(--x)}div.nslide.editing,div.nslide:focus{box-shadow:inset 0 0 0 1px var(--blu),0 0 0 3px color-mix(in srgb,var(--blu) 22%,transparent)}div.bb-select,select{background-color: