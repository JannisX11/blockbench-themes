{
  "name": "Claude (Light)",
  "author": "Draco12191712",
  "version": "1.0.0",
  "borders": false,
  "main_font": "fnt1",
  "headline_font": "fnt2",
  "code_font": "anthropic-serif",
  "css": "/*\n\nClaude (Light)\nBy Draco12191712\n\n*/\n@import url(\"https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..24,300,0..1,0\");\n#_{}body{--asdf:#fcfcfb;--x:rgba(11,11,11,.05);--xx:rgba(11,11,11,.09);--xxx:rgba(11,11,11,.2);--tmp:rgba(11,11,11,.08);--tmp2:rgba(11,11,11,.1);--p0p:#ffffff;--sh:0 0 0 .5px #0000001a,0 4px 12px #0000000f,0 16px 40px #00000014;--seg:#ffffff;--blu:#2a78d6;--lnk:#256abf;--red:#d03b3b;--b1:#0b0b0b;--b2:#2c2c2a;--b3:#ffffff;--btn:rgba(11,11,11,.06);--btn2:rgba(11,11,11,.1);--fld:rgba(255,255,255,.5)}@font-face{font-family:fnt1;src:url(data:font/woff2;base64,)format(\"woff2\");font-weight:300 700;font-style:normal}@font-face{font-family:fnt2;src:url(data:font/woff2;base64,)format(\"woff2\");font-weight:400 700;font-style:normal}body{--font-main: var(--font-custom-main), -apple-system, BlinkMacSystemFont, system-ui, \"Segoe UI\", sans-serif;--font-headline: var(--font-custom-headline), Georgia, \"Times New Roman\", serif;--font-code: var(--font-custom-code), \"SF Mono\", ui-monospace, Menlo, Consolas, monospace;font-size:14px;-webkit-font-smoothing:antialiased;--color-close: var(--red);--color-error: var(--red);--color-confirm: #35b231;--color-warning: #fab219}body[theme-accent=blue]{--color-accent: var(--blu);--color-accent_text: #fff }::selection{background:color-mix(in srgb,var(--blu) 35%,transparent);color:inherit}*{scrollbar-color:var(--xxx) transparent}.list{background-color:transparent}.list::-webkit-scrollbar-track{background:transparent}#page_wrapper{border-color:var(--asdf);background-color:var(--asdf)}#work_screen,.sidebar,#main_toolbar,#status_bar,#top_slot,#bottom_slot{background-color:var(--asdf)}header{background-color:var(--asdf)}#tab_bar{background:var(--asdf)}body[mode=start] div#center.checkerboard{background-color:var(--asdf)}#corner_logo img{opacity:.42}body.light_mode #corner_logo img{filter:invert(1);opacity:.5}.checkerboard,.checkerboard_trigger .checkerboard_target{--color-checker_offset:rgba(0,0,0,.12)}body.light_mode .checkerboard,body.light_mode .checkerboard_trigger .checkerboard_target{--color-checker_offset:rgba(11,11,11,.035)}body.light_mode .outliner_object .icon[style],body.light_mode .texture .icon[style]{filter:brightness(.68) saturate(1.7)}li.menu_bar_point{font-size:13px;height:24px;margin-top:3px;padding:0 9px;min-width:0;border-radius:6px;display:inline-flex;align-items:center;color:var(--color-text);transition:background-color .12s}li.menu_bar_point:hover{background:var(--x);color:var(--color-light)}li.menu_bar_point.opened{background:var(--xx);color:var(--color-light)}div#header_free_bar.app-drag-region{font-size:13px;padding-top:6px;color:var(--color-subtle_text)}#web_download_button{background:transparent;font-size:13px}#web_download_button:hover{background:transparent}#tab_bar{padding:3px 6px 1px}#tab_bar .project_tab{border-radius:8px!important;height:28px;padding:3px 6px 3px 8px;margin:0 1px;color:var(--color-subtle_text);font-size:13px;align-items:center}#tab_bar .project_tab.selected{background-color:var(--xx);color:var(--color-light)}#tab_bar .project_tab.selected:before,#tab_bar .project_tab.selected:after{display:none}#tab_bar .project_tab:not(.selected):hover{background-color:var(--x);color:var(--color-light)}#tab_bar .project_tab.dragging{background-color:var(--p0p);box-shadow:var(--sh)}#tab_bar .project_tab>.icon{font-size:18px;color:var(--color-subtle_text)}#tab_bar .project_tab_close_button{border-radius:6px;flex-basis:22px;height:22px}#tab_bar .project_tab_close_button:hover{background:var(--xx)}#tab_bar .project_tab_close_button>*{font-size:16px;padding-top:3px}#new_tab_button,#search_tab_button{border-radius:8px;height:28px;margin-top:0;color:var(--color-subtle_text)}#new_tab_button:hover,#search_tab_button:hover{background:var(--x);color:var(--color-light)}#main_toolbar{padding:5px 8px}.tool{border-radius:6px;transition:background-color .12s,color .12s}.tool:hover{color:var(--color-light)}.toolba