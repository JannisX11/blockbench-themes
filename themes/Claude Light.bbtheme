  "thumbnail": ".theme_preview_window{padding:0 3px 3px;gap:3px}.theme_preview_sidebar{flex-basis:38px;border-radius:5px;box-shadow:inset 0 0 0 1px #80808033}.theme_preview_sidebar:after{background-color:transparent;border-top:1px solid rgba(128,128,128,.2)}.theme_preview_menu{border-radius:6px;box-shadow:0 0 0 .5px #80808059,0 4px 10px #00000040}.theme_preview_menu_header{background-color:#80808033;border-radius:4px;height:14px;margin-top:3px}.theme_preview_menu_header>.theme_preview_text{background-color:var(--color-light);margin:5px 4px}.theme_preview_center{border-color:var(--color-accent);opacity:.8}.theme_preview_text{border-radius:9px}",
  "desktop_only": true,
  "colors": {
    "ui": "#ffffff",
    "back": "#f9f9f7",
    "dark": "#fcfcfb",
    "border": "#e5e4df",
    "selected": "#e7e7e6",
    "elevated": "#f3f3f2",
    "button": "#ededeb",
    "bright_ui": "#ffffff",
    "accent": "#c6613f",
    "frame": "#fcfcfb",
    "text": "#2c2c2a",
    "light": "#0b0b0b",
    "accent_text": "#ffffff",
    "bright_ui_text": "#131313",
    "subtle_text": "#7b7974",
    "grid": "#c9c8bf",
    "wireframe": "#7b7974",
    "checkerboard": "#f3f3f0"
  },
  "options": {
    "icons": {
      "name": "Icons",
      "options": {
        "thin": "Claude (thin)",
        "classic": "Classic"
