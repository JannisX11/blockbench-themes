/*
id: frost
name: Frost
author: ThePinkHacker
version: 2.0.0
main_font: Helvetica, Arial, sans-serif
headline_font: Helvetica, Arial, sans-serif
code_font: Menlo, Meslo, monospace
borders: false
*/

body {
    --color-ui: #282c34;
    --color-back: #21252b;
    --color-dark: #17191d;
    --color-border: #23252b;
    --color-selected: #474d5d;
    --color-button: #3a3f4b;
    --color-bright_ui: #f4f3ff;
    --color-accent: #3e90ff;
    --color-frame: #181a1f;
    --color-text: #cacad4;
    --color-light: #f4f3ff;
    --color-accent_text: #000006;
    --color-bright_ui_text: #000006;
    --color-subtle_text: #848891;
    --color-grid: #495061;
    --color-wireframe: #576f82;
    --color-checkerboard: #1c2026;

}

@scope (thumbnail) {
    :root {
        --frost-radius: 8px;
    }
    
    .theme_preview_menu,
    .theme_preview_menu_header {
        border-radius: var(--frost-radius);
    }
    
    .theme_preview_menu {
        background-color: var(--color-back);
    }
    
    .theme_preview_text {
        background-color: var(--color-text);
    }
}

/* === Frost === */

@font-face {
    font-family: "Menslo";
    src: url("https://github.com/uncon/MesloLGSNF-web-fonts/raw/874c562a09457f52242b36ba5f7f2a85557131de/fonts/MesloLGS-NF-Regular.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}

body {
    --menu-bar-height: fit-content;
}

:root {
    --frost-radius: 8px;
    --frost-shadow-size: 4px;
    --frost-shadow-blur: 8px;
    --frost-shadow-color: rgba(0, 0, 0, 0.25);
    --frost-background-blur: 8px;
    --frost-background-opacity: 15%;
}

*:not(.scroll_horizontal) {
    scrollbar-width: unset;
}

/* === Header === */

header {
    align-items: center;
}

header > * {
    height: unset;
}

.menu_bar_point {
    border: 4px solid var(--color-border);
    margin: 4px;
}

/* === End Header === */

/* Border Radius */
dialog,
.dialog_handle, /* Dialog top draggable area */
.menu_bar_point,
.contextMenu
{
    border-radius: var(--frost-radius);
}

/* === Dialogs === */

.dialog_handle {
    height: 3rem;
}

/* Fix box shadow from dialog_handle */
.dialog_wrapper {
    z-index: -1;
}

/* === End Dialogs === */

/* === Context Menu === */

.contextMenu {
    background: none;
    color: var(--color-text);
}

/* Fixes rendering issue 

Sub menus aren't blurred.

The fix is to create a before psudo-element with every menu.
Each before gets the blur while the menus are transparent.
*/
.contextMenu:before {
    content: "";
    z-index: -1;
    position: absolute;
    display: block;
    width: 100%;
    height: 100%;
}

/* === End Context Menu === */

/* === Shadow === */

/* Bottom Shadow */
.dialog_handle {
    box-shadow: var(--frost-shadow-color) 0 var(--frost-shadow-size) var(--frost-shadow-blur);
}

/* All Shadow */
dialog,
.contextMenu {
    box-shadow: var(--frost-shadow-color) 0 0 var(--frost-shadow-blur) var(--frost-shadow-size);
}

/* === End Shadow === */

/* === Blur === */

dialog,
.contextMenu:before {
    backdrop-filter: blur(var(--frost-background-blur));
    background-color: rgba(var(--color-ui), var(--frost-background-opacity));
}

/* === End Blur === */
